# ============================================================
# SIGELAB-INCOS - Variables de entorno
# Copiar este archivo a .env y ajustar los valores.
# Para credenciales reales crear .env.local (ignorado por Git).
# ============================================================

# Direccion base del nucleo SIA-INCOS, SIN barra final.
# Produccion (Railway):
#   API_ACADEMICO_URL=https://sia-incos-api-production.up.railway.app
# Simulador local incluido (npm run mock-sia):
#   API_ACADEMICO_URL=http://127.0.0.1:3000
API_ACADEMICO_URL=https://sia-incos-api-production.up.railway.app

# Sigla que identifica a SIGELAB en el header X-Sistema del SIA.
# El SIA usa este header para saber que equipo esta conectado.
SIA_SISTEMA=SIGELAB

# Puerto del demo SIGELAB (segun contrato: 4100)
PORT=4100

# ------------------------------------------------------------
# Almacenamiento propio del SIGELAB
# ------------------------------------------------------------
# auto      -> Firestore si existe serviceAccountKey.json; si no, archivo JSON local
# firestore -> obliga a Firebase (falla si falta la clave)
# file      -> archivo local data/store.json
DB_BACKEND=auto

# Firebase (proyecto del SIGELAB)
# Descargar el service account desde:
# Firebase Console > Configuracion del proyecto > Cuentas de servicio
GOOGLE_APPLICATION_CREDENTIALS=./serviceAccountKey.json
FIREBASE_PROJECT_ID=incos-sigelab-2026

# Alternativa: credenciales en una sola variable JSON
# FIREBASE_SERVICE_ACCOUNT={"type":"service_account",...}

# Emulador de Firestore (opcional, para desarrollo sin credenciales)
# FIRESTORE_EMULATOR_HOST=127.0.0.1:8080

# ------------------------------------------------------------
# Cuentas locales SIGELAB (registro y recuperacion de clave)
# ------------------------------------------------------------
# true  -> el codigo de 4 digitos se muestra en pantalla y consola (demo)
# false -> solo se envia por correo/WhatsApp (requiere credenciales)
AUTH_DEMO_CODES=true
JWT_LOCAL_EXPIRA=8h

# Gmail SMTP (para envio real de codigos por correo)
# 1. Activar verificacion en dos pasos en la cuenta Gmail.
# 2. Crear una contrasena de aplicacion: https://myaccount.google.com/apppasswords
# 3. Completar SMTP_USER y SMTP_PASS.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# WhatsApp: demo | twilio | meta
# demo   -> el codigo se muestra en pantalla/consola
# twilio -> completar TWILIO_ACCOUNT_SID, TWILIO_AUTH_TOKEN y TWILIO_WHATSAPP_FROM
# meta   -> completar META_WHATSAPP_TOKEN y META_WHATSAPP_PHONE_NUMBER_ID
WHATSAPP_PROVIDER=demo
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=
META_WHATSAPP_TOKEN=
META_WHATSAPP_PHONE_NUMBER_ID=
META_WHATSAPP_API_VERSION=v20.0
