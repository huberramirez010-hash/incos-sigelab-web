# ============================================================
# SIGELAB-INCOS - Entorno de desarrollo/demo
# Este archivo NO contiene secretos y puede versionarse.
# Para credenciales reales use .env.local (ignorado por Git).
# Las credenciales de Firebase van en serviceAccountKey.json
# (ignorado por Git).
# ============================================================

# Nucleo SIA en produccion (Railway).
# El JWKS rota con kid sia-2026-2. Para usar el simulador local:
#   API_ACADEMICO_URL=http://127.0.0.1:3000
API_ACADEMICO_URL=https://sia-incos-api-production.up.railway.app

# Sigla que identifica a SIGELAB en el header X-Sistema del SIA.
SIA_SISTEMA=SIGELAB

PORT=4100

# auto       -> Firestore si existe serviceAccountKey.json; si no, archivo local
# firestore  -> obliga a usar Firebase (falla si falta la clave)
# file       -> archivo data/store.json
DB_BACKEND=auto

# Firebase (proyecto del SIGELAB)
GOOGLE_APPLICATION_CREDENTIALS=./serviceAccountKey.json
FIREBASE_PROJECT_ID=incos-sigelab-2026

# ------------------------------------------------------------
# Cuentas locales SIGELAB (registro y recuperacion de clave)
# ------------------------------------------------------------
# true  -> el codigo de 4 digitos se muestra en pantalla y consola (demo)
# false -> solo se envia por correo/WhatsApp (requiere credenciales)
AUTH_DEMO_CODES=true
JWT_LOCAL_EXPIRA=8h

# Gmail SMTP (para envio real de codigos por correo)
# Crear una contrasena de aplicacion en https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# WhatsApp: demo | twilio | meta
WHATSAPP_PROVIDER=demo
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=
META_WHATSAPP_TOKEN=
META_WHATSAPP_PHONE_NUMBER_ID=
META_WHATSAPP_API_VERSION=v20.0
